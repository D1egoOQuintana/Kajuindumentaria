rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function hasSafeProductPath(productId, fileName) {
      return productId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && productId.size() <= 140
        && fileName.matches('^[A-Za-z0-9][A-Za-z0-9._-]{0,160}$');
    }

    match /products/{productId}/{fileName} {
      allow read: if true;

      allow create, update: if isAdmin()
        && hasSafeProductPath(productId, fileName)
        && request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)')
        && request.resource.metadata.productId == productId;

      allow delete: if isAdmin() && hasSafeProductPath(productId, fileName);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
