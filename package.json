{
  "name": "kajuu-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:rules": "npx --yes firebase-tools@13.35.1 emulators:exec --only firestore,storage \"vitest run --config vitest.rules.config.mts\"",
    "check": "npm run lint && npm run test && npm run test:rules && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "admin:grant": "tsx scripts/set-admin-claim.ts",
    "seed:products": "tsx scripts/seed-products.ts"
  },
  "dependencies": {
    "@rive-app/react-canvas-lite": "^4.34.3",
    "firebase": "^12.19.0",
    "firebase-admin": "13.10.0",
    "next": "^16.3.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@fastify/busboy": "^3.2.2",
    "@grpc/grpc-js": "^1.14.5",
    "uuid": "^11.1.1"
  }
}
